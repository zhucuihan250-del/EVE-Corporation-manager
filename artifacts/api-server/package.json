{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:fitting-advice": "esbuild src/lib/fitting-advice.test.ts src/lib/fitting-advice-prices.test.ts src/lib/fitting-engine-worker.ts --bundle --platform=node --format=esm --alias:@workspace/db/schema=../../lib/db/src/schema/index.ts --alias:@workspace/db=../../lib/db/src/schema/index.ts --external:express --external:pino --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --external:@eveshipfit/dogma-engine --external:@eveshipfit/sde --outdir=node_modules/.cache/fitting-advice-tests --out-extension:.js=.mjs && node --test \"$PWD/node_modules/.cache/fitting-advice-tests/fitting-advice.test.mjs\" \"$PWD/node_modules/.cache/fitting-advice-tests/fitting-advice-prices.test.mjs\"",
    "test:fitting-models": "esbuild src/lib/fitting-models.test.ts --bundle --platform=node --format=esm --external:express --external:pino --outfile=node_modules/.cache/fitting-models.test.mjs && node --test \"$PWD/node_modules/.cache/fitting-models.test.mjs\"",
    "test:fitting-workbench": "esbuild src/lib/fitting-workbench.test.ts src/lib/fitting-workbench-skills.test.ts src/lib/fitting-engine-worker.ts --bundle --platform=node --format=esm --alias:@workspace/db/schema=../../lib/db/src/schema/index.ts --alias:@workspace/db=../../lib/db/src/schema/index.ts --external:express --external:pino --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --external:@eveshipfit/dogma-engine --external:@eveshipfit/sde --outdir=node_modules/.cache/fitting-workbench-tests --out-extension:.js=.mjs && node --test \"$PWD/node_modules/.cache/fitting-workbench-tests/fitting-workbench.test.mjs\" \"$PWD/node_modules/.cache/fitting-workbench-tests/fitting-workbench-skills.test.mjs\"",
    "test:fitting": "esbuild src/lib/fitting-engine.test.ts src/lib/fitting-engine-worker.ts --bundle --platform=node --format=esm --out-extension:.js=.mjs --outdir=node_modules/.cache/fitting-tests && node --test \"$PWD/node_modules/.cache/fitting-tests/fitting-engine.test.mjs\"",
    "test:pap-currencies": "esbuild src/lib/pap-currency-math.test.ts src/lib/pap-currency-database.test.ts src/lib/pap-currency-account-merge.test.ts src/lib/fleet-pap.test.ts --bundle --platform=node --format=esm --alias:@workspace/db/schema=../../lib/db/src/schema/index.ts --alias:@workspace/db=../../lib/db/src/schema/index.ts --external:express --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outdir=node_modules/.cache/pap-currency-tests && node --test \"$PWD/node_modules/.cache/pap-currency-tests/pap-currency-math.test.js\" \"$PWD/node_modules/.cache/pap-currency-tests/pap-currency-database.test.js\" \"$PWD/node_modules/.cache/pap-currency-tests/pap-currency-account-merge.test.js\" \"$PWD/node_modules/.cache/pap-currency-tests/fleet-pap.test.js\"",
    "test:buyback": "esbuild src/lib/buyback-calculation.test.ts src/lib/buyback-database.test.ts src/lib/buyback-provider.test.ts --bundle --platform=node --format=esm --external:express --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outdir=node_modules/.cache/buyback-tests && node --test \"$PWD/node_modules/.cache/buyback-tests/buyback-calculation.test.js\" \"$PWD/node_modules/.cache/buyback-tests/buyback-database.test.js\" \"$PWD/node_modules/.cache/buyback-tests/buyback-provider.test.js\"",
    "test:single-corporation": "esbuild src/lib/single-corporation-integration.test.ts src/lib/single-corporation-rules.test.ts --bundle --platform=node --format=esm --alias:@workspace/db/schema=../../lib/db/src/schema/index.ts --alias:@workspace/db=./src/lib/single-corporation-test-db.ts --external:express --external:pino --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outdir=node_modules/.cache/single-corporation-tests && node --test \"$PWD/node_modules/.cache/single-corporation-tests/single-corporation-integration.test.js\" \"$PWD/node_modules/.cache/single-corporation-tests/single-corporation-rules.test.js\"",
    "test:diplomacy": "esbuild src/lib/diplomacy-management.test.ts src/lib/diplomacy-management-database.test.ts --bundle --platform=node --format=esm --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outdir=node_modules/.cache/diplomacy-tests && node --test \"$PWD/node_modules/.cache/diplomacy-tests/diplomacy-management.test.js\" && node --test \"$PWD/node_modules/.cache/diplomacy-tests/diplomacy-management-database.test.js\"",
    "test:solar-system-search": "esbuild src/lib/solar-system-search.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/solar-system-search.test.mjs && node --test \"$PWD/node_modules/.cache/solar-system-search.test.mjs\"",
    "test:system-monitoring-db": "esbuild src/lib/system-monitoring-database.test.ts --bundle --platform=node --format=esm --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outfile=node_modules/.cache/system-monitoring-database.test.mjs && node --test \"$PWD/node_modules/.cache/system-monitoring-database.test.mjs\"",
    "test:system-monitoring-map": "esbuild src/lib/system-monitoring-map.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/system-monitoring-map.test.mjs && node --test \"$PWD/node_modules/.cache/system-monitoring-map.test.mjs\"",
    "test:system-monitoring-rules": "esbuild src/lib/system-monitoring-rules.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/system-monitoring-rules.test.mjs && node --test \"$PWD/node_modules/.cache/system-monitoring-rules.test.mjs\"",
    "test:rewards": "esbuild src/lib/reward-access.test.ts --bundle --platform=node --format=esm --external:@electric-sql/pglite --external:drizzle-orm --external:drizzle-orm/* --outfile=node_modules/.cache/reward-access.test.mjs && node node_modules/.cache/reward-access.test.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@carbonenginejs/runtime": "0.1.0-alpha.8",
    "@carbonenginejs/tools-core": "0.8.0",
    "@eveshipfit/dogma-engine": "13.1.0",
    "@eveshipfit/sde": "8.3561556.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-fetch": "^3.3.2",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
